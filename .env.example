# npm start works without this file. Requires Node.js 22+ and initial network access.
# Local development state/encryption keys persist under ignored .local/.
DEV_AUTH=true
APP_ORIGIN=http://127.0.0.1:4318
PORT=4318
HARNESS_DATA_DIR=.local

# Optional for local startup; Compose supplies its own Postgres/Redis URLs.
# DATABASE_URL=postgresql://harness:URL_ENCODED_PASSWORD@127.0.0.1:5432/harness
# REDIS_URL=redis://127.0.0.1:6379

# PRODUCTION: configure all these values; disable the local guest path.
# DEV_AUTH=false
# APP_ORIGIN=https://harness.example.com
# DATABASE_URL=postgresql://user:URL_ENCODED_PASSWORD@db.example.com:5432/harness?sslmode=require
# REDIS_URL=rediss://user:URL_ENCODED_PASSWORD@redis.example.com:6379
# HARNESS_MASTER_KEY=GENERATE_A_BASE64_32_BYTE_KEY
# AUTH_SECRET=GENERATE_AN_INDEPENDENT_RANDOM_SECRET
# AUTH_TRUST_HOST=true
# Generate each secret independently, one invocation per secret:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64')+'\n')"

# Configure GitHub OAuth, email, or both. OAuth callback:
# APP_ORIGIN/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# EMAIL_SERVER=smtps://user:URL_ENCODED_PASSWORD@smtp.example.com:465
# EMAIL_FROM=Harness <sign-in@example.com>

# Account connections run locally. Install the official Claude Code client on this host.
# Optional if its executable is not on PATH:
# HARNESS_CLAUDE_BINARY=/absolute/path/to/claude
# ChatGPT needs no separately registered client ID, client secret, or API key
# for the supported local Sign in with ChatGPT public-client flow.
# Never place account credentials in NEXT_PUBLIC_* variables.

# Do not set HARNESS_E2E / HARNESS_TEST_PROVIDER_ORIGIN in a deployed environment.
