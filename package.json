{
  "name": "harness-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider AI chat with private, server-compiled expert personas.",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4318",
    "build": "next build --webpack",
    "build:web": "node scripts/build-web-shell.mjs",
    "start": "node scripts/start.mjs",
    "serve": "next start --hostname 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "legacy": "node server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@electric-sql/pglite": "0.5.16",
    "postgres": "4.1.1",
    "ioredis": "6.0.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.6.0",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "lucide-react": "1.74.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "katex": "0.19.1",
    "shiki": "4.6.0",
    "react-textarea-autosize": "8.5.9",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/nodemailer": "8.0.2",
    "vitest": "5.1.0",
    "tsx": "4.23.15",
    "@playwright/test": "1.65.1"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "katex": "$katex"
  }
}
